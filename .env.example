# Copy to .env.local (git-ignored) for `npm run dev`. On Vercel, set the same
# names under Project Settings → Environment Variables.

# Your OpenAI key. Stays on the server; the browser never sees it.
OPENAI_API_KEY=

# Any code you like. Type the same code in the app: Grown-ups → Talk with Khru Mali.
CHAT_PASSCODE=

# Optional: gpt-realtime-2.1 (default) or the cheaper gpt-realtime-2.1-mini
# REALTIME_MODEL=gpt-realtime-2.1
